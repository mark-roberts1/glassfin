// A DualShock 4 as SDL reports it.
//
// SDL calls this pad "PS4 Controller" whether it is on USB or Bluetooth — the
// kernel's name for a Bluetooth one is "Wireless Controller", but SDL normalises
// it, so this file is the one that applies either way. dualshock4.json matches
// the kernel name and is what you get if something reports the pad raw.
//
// The button numbers are SDL's gamepad order, confirmed on hardware:
//   0 X    1 Circle  2 Square  3 Triangle  4 Share  5 PS
//   6 Options  7 L3  8 R3  9 L1  10 R1  11 Touchpad
// and the axes are 0/1 left stick, 2/3 right stick, 4 L2, 5 R2.
//
// **The triggers rest at full negative**, so L2 and R2 read as `_DOWN` when
// pressed and sit permanently `_UP` when they are not. Only the `_DOWN` half of
// a trigger is worth binding.
{
  "name": "Playstation DualShock 4 - USB",
  "idmatcher": "PS4 Controller",
  "mapping": {
    // D-Pad
    "KEY_HAT_DOWN": "down",
    "KEY_HAT_UP": "up",
    "KEY_HAT_RIGHT": "right",
    "KEY_HAT_LEFT": "left",

    // X — select
    "KEY_BUTTON_0": "enter",

    // Circle — back, or home if you hold it
    "KEY_BUTTON_1": {
      "short": "back",
      "long": "home"
    },

    // Square — mute
    "KEY_BUTTON_2": "mute",

    // Triangle — the audio and subtitle menu
    "KEY_BUTTON_3": "menu",

    // Share — fullscreen
    "KEY_BUTTON_4": "host:fullscreen",

    // PS button — home, or quit if you hold it
    "KEY_BUTTON_5": {
      "short": "home",
      "long": "exit"
    },

    // Options — play/pause
    "KEY_BUTTON_6": "play_pause",

    // Thumbstick presses, deliberately unbound
    "KEY_BUTTON_7": "",
    "KEY_BUTTON_8": "",

    // L1 / R1 — scan back and forward. Each press doubles the speed.
    "KEY_BUTTON_9": "rewind",
    "KEY_BUTTON_10": "fast_forward",

    // Touchpad press — search
    "KEY_BUTTON_11": "search",

    // L2 / R2 — volume, which ramps while held
    "KEY_AXIS_4_DOWN": "decrease_volume",
    "KEY_AXIS_5_DOWN": "increase_volume",

    // Left thumbstick — navigation, same as the D-pad
    "KEY_AXIS_0_UP": "left",
    "KEY_AXIS_0_DOWN": "right",
    "KEY_AXIS_1_UP": "up",
    "KEY_AXIS_1_DOWN": "down",

    // Right thumbstick — volume up and down, audio delay left and right
    "KEY_AXIS_3_UP": "increase_volume",
    "KEY_AXIS_3_DOWN": "decrease_volume",
    "KEY_AXIS_2_UP": "decrease_audio_delay",
    "KEY_AXIS_2_DOWN": "increase_audio_delay"
  }
}
